rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // =========================================================================
    // HELPER FUNCTIONS & ZERO-TRUST AUTH RULES
    // =========================================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == "soham@botmartz.com" ||
        request.auth.token.email == "team@botmartz.com" ||
        request.auth.token.email == "sharmasoham2710@gmail.com" ||
        request.auth.token.admin == true
      );
    }

    // =========================================================================
    // 1. STUDENT PROFILES & PUBLIC MEMBER PORTFOLIOS
    // =========================================================================
    match /student_profiles/{profileId} {
      allow read: if true; // Public read for builder portfolio and contribution heatmap pages
      allow create, update: if isAuthenticated() && (
        request.auth.uid == profileId ||
        request.auth.token.email == request.resource.data.email ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 2. ARENA ENROLLMENTS & PROJECT TRACKS
    // =========================================================================
    match /arena_enrollments/{enrollmentId} {
      allow read: if true;
      allow create: if true; // Allows initial enrollment submission
      allow update: if isAuthenticated() && (
        request.auth.token.email == resource.data.email ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 3. DAILY PROOF-OF-WORK (POW) LOGS & STREAKS
    // =========================================================================
    match /arena_daily_logs/{logId} {
      allow read: if true;
      allow create: if true;
      allow update: if isAuthenticated() && (
        request.auth.token.email == resource.data.studentEmail ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /daily_logs/{logId} {
      allow read: if true;
      allow create: if true;
      allow update: if isAuthenticated() && (
        request.auth.token.email == resource.data.studentEmail ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 4. CAREER CHECKLIST & LINKEDIN UGC PROOFS
    // =========================================================================
    match /career_checklists/{docId} {
      allow read: if true;
      allow write: if isAuthenticated() || isAdmin();
    }

    // =========================================================================
    // 5. COMMUNITY DISCUSSIONS & COMMENTS
    // =========================================================================
    match /discussions/{discussionId} {
      allow read: if true;
      allow create: if isAuthenticated() || isAdmin();
      allow update: if isAuthenticated() || isAdmin();
      allow delete: if isAdmin();
      
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated() || isAdmin();
        allow update, delete: if isAdmin();
      }
    }

    // =========================================================================
    // 6. CUSTOM ARENA PROJECTS & DYNAMIC PRDs
    // =========================================================================
    match /custom_arena_projects/{projectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =========================================================================
    // 7. COHORT CALENDAR EVENTS & DEADLINES
    // =========================================================================
    match /cohort_calendar_events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =========================================================================
    // 8. ARENA BOUNTIES, BUGS & CUSTOM PROPOSALS
    // =========================================================================
    match /arena_bounties/{bountyId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /arena_bug_reports/{bugId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /arena_custom_proposals/{propId} {
      allow read: if true;
      allow create: if isAuthenticated() || isAdmin();
      allow update, delete: if isAdmin();
    }

    match /arena_referral_claims/{claimId} {
      allow read: if true;
      allow create: if isAuthenticated() || isAdmin();
      allow update, delete: if isAdmin();
    }

    match /arena_analytics_events/{eventId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // =========================================================================
    // 9. STUDENT WALLETS & KARMA COIN TRANSACTIONS
    // =========================================================================
    match /student_wallets/{email} {
      allow read: if isAuthenticated() && (
        request.auth.token.email == email ||
        isAdmin()
      );
      allow write: if isAuthenticated() && (
        request.auth.token.email == email ||
        isAdmin()
      );
    }

    match /wallet_transactions/{txId} {
      allow read: if isAuthenticated() && (
        request.auth.token.email == resource.data.studentEmail ||
        isAdmin()
      );
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // =========================================================================
    // 10. GLOBAL SETTINGS, AUDIT LEDGER & RBAC TEAM
    // =========================================================================
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /team_members/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /security_audit_ledger/{logId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // =========================================================================
    // 11. EVENTS, TICKETS & ATTENDEE REGISTRATIONS
    // =========================================================================
    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /attendees/{attendeeId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /event_registrations/{regId} {
      allow read: if true;
      allow write: if true;
    }

    // =========================================================================
    // 12. RAZORPAY ORDERS & PAYMENTS
    // =========================================================================
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (
        request.auth.token.email == resource.data.email ||
        isAdmin()
      );
      allow write: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (
        request.auth.token.email == resource.data.email ||
        isAdmin()
      );
      allow write: if isAdmin();
    }

    // =========================================================================
    // 13. CERTIFICATES & VERIFICATION
    // =========================================================================
    match /certificates/{certId} {
      allow read: if true; // Public verification by QR / Certificate ID
      allow write: if isAdmin();
    }

    // =========================================================================
    // 14. CHALLENGES & LEADERBOARDS
    // =========================================================================
    match /challenges/{challengeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /challenge_submissions/{subId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // =========================================================================
    // 15. SHOWCASE, GALLERY, FEEDBACK & NEWSLETTER
    // =========================================================================
    match /showcase/{itemId} {
      allow read: if true;
      allow create: if isAuthenticated() || isAdmin();
      allow update: if isAuthenticated() || isAdmin();
      allow delete: if isAdmin();
    }

    match /gallery/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /feedback/{feedbackId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /testimonials/{testimonialId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /newsletter/{subId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /coupons/{couponId} {
      allow read, write: if true;
    }

    // =========================================================================
    // 16. DEFAULT SECURE FALLBACK
    // =========================================================================
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
